{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "digimon-autochess-mp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // stamps src/game/rules-version.ts with the hash of the rules this build bundles
  "build": { "command": "npm run --silent rules-version" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "MatchRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "QUEUE", "class_name": "Matchmaker" },
      { "name": "LB", "class_name": "Leaderboard" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "SOCIAL", "class_name": "Social" }
    ]
  },
  // Google sign-in (the OAuth client's id isn't secret; SESSION_SECRET is a worker secret)
  "vars": { "GOOGLE_CLIENT_ID": "629270363914-ud33joi20b3f33iinhh4c9nan03hamig.apps.googleusercontent.com" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Leaderboard"] },
    { "tag": "v3", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v4", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v5", "new_sqlite_classes": ["Account"] },
    { "tag": "v6", "new_sqlite_classes": ["Social"] }
  ],
  "observability": { "enabled": true },
  // the test channel's own worker (`npm run deploy:worker:v3`): the next rules (branch v3)
  // with their own lobbies, queue and leaderboard — live players never meet test builds
  "env": {
    "v3": {
      "name": "digimon-autochess-mp-v3",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "MatchRoom" },
          { "name": "LOBBY", "class_name": "Lobby" },
          { "name": "QUEUE", "class_name": "Matchmaker" },
          { "name": "LB", "class_name": "Leaderboard" },
          { "name": "ACCOUNT", "class_name": "Account" },
          { "name": "SOCIAL", "class_name": "Social" }
        ]
      },
      "vars": { "GOOGLE_CLIENT_ID": "629270363914-ud33joi20b3f33iinhh4c9nan03hamig.apps.googleusercontent.com" }
    }
  }
}
