{
  "name": "digimon-autochess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "rules-version": "node scripts/rules-version.mjs",
    "jp-fonts": "node scripts/jp-fonts.mjs",
    "predev": "node scripts/rules-version.mjs",
    "dev": "vite",
    "prebuild": "node scripts/rules-version.mjs && node scripts/jp-fonts.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "balance": "esbuild scripts/balance-sim.ts --bundle --platform=node --outfile=node_modules/.cache/balance-sim.cjs --log-level=warning && node node_modules/.cache/balance-sim.cjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=digimon-autochess --commit-dirty=true",
    "deploy:v3": "VITE_CHANNEL=v3 npm run build && npx wrangler pages deploy dist --project-name=digimon-autochess --branch=v3 --commit-dirty=true",
    "deploy:worker:v3": "npx wrangler deploy --config server/wrangler.jsonc --env v3",
    "deploy:mirror": "npx wrangler deploy --config site/wrangler.jsonc",
    "optimize-models": "node scripts/optimize-models.mjs",
    "check-models": "node scripts/check-models.mjs",
    "runsim": "node scripts/run-ts.mjs scripts/run-sim.ts",
    "lobbycheck": "node scripts/run-ts.mjs scripts/lobby-check.ts",
    "clip": "node scripts/clip/record.mjs && python3 scripts/clip/assemble.py"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.69.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
